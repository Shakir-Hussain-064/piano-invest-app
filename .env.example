PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/piano
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
APP_ORIGIN=http://localhost:3001
# Keep false for all real-payment environments. Use true only for local demo testing.
DEMO_PAYMENTS=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RazorpayX bank payouts: separate account, credentials, webhook and prefunded balance.
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
# 64 hex characters (32 random bytes); required to encrypt beneficiary details.
BANK_DATA_KEY=
# For local development only; requires downloading the MongoDB binary:
USE_MEMORY_DB=false
